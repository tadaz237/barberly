# Database - Neon/Postgres
# Use the pooled URL for the app runtime on Vercel/Neon.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Optional direct URL for Prisma CLI commands such as migrate deploy.
# On Neon this is usually the same host without "-pooler".
# If omitted, prisma.config.ts tries to derive it from DATABASE_URL.
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@DIRECT_HOST/neondb?sslmode=require"

# Auth.js - generate with `npx auth secret`
AUTH_SECRET=replace-me
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Google OAuth - https://console.cloud.google.com/apis/credentials
# Local redirect URI:
#   http://localhost:3000/api/auth/callback/google
# Production redirect URI:
#   https://your-domain.com/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Platform admin emails, comma-separated.
# These users can access /platform/kyc to validate or reject KYC submissions.
PLATFORM_ADMIN_EMAILS=

# Public URL used by CinetPay callbacks.
# In production: https://your-domain.com
# In local tests, use a public HTTPS tunnel if the payment provider calls back.
APP_BASE_URL=http://localhost:3000

# CinetPay checkout.
# Keep these values server-side only. Do not prefix them with NEXT_PUBLIC_.
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_CURRENCY=XAF
CINETPAY_CHANNELS=MOBILE_MONEY
CINETPAY_CUSTOMER_COUNTRY=CM
CINETPAY_DEFAULT_CITY=Douala
CINETPAY_DEFAULT_ZIP_CODE=00000
CINETPAY_DEFAULT_ADDRESS=Non renseigne

# Cloudinary image storage
# https://console.cloudinary.com
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# SMTP transactional emails
# Required for two-factor login and password reset codes.
# Use port 587 with SMTP_SECURE=false or port 465 with SMTP_SECURE=true.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Barberly <no-reply@example.com>"

# Keep false on Vercel. Set true only for a trusted local SMTP relay with no auth.
SMTP_AUTH_DISABLED=false

# Browser push notifications
# Generate keys with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:no-reply@example.com
